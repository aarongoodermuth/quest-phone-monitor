<?xml version="1.0" encoding="utf-8"?>
<!--
  Quest Phone Monitor — sender (phone side), v0.3

  Captures this phone's screen with MediaProjection and serves it as an
  MJPEG stream on the local Wi-Fi, advertised over mDNS so the Quest
  receiver finds it with no typing.

  Android 10+ (minSdk 29) requires the capture to run from a foreground
  service of type mediaProjection — see ScreenCaptureService. The service
  must be started before MediaProjectionManager.getMediaProjection() is
  called, which is why MainActivity hands the capture-permission result
  to the service instead of capturing itself.

  v0.3 adds control: the Quest (or a browser on the viewer page) sends
  taps/swipes/keys to POST /control, and QpmAccessibilityService
  performs them with dispatchGesture — no root, no ADB. The user enables
  that service once in Settings → Accessibility.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-sdk
        android:minSdkVersion="29"
        android:targetSdkVersion="34" />

    <!-- Local network streaming. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />

    <!-- Foreground service that owns the MediaProjection capture. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />

    <application
        android:allowBackup="true"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.QpmSender">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="unspecified">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".ScreenCaptureService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />

        <!-- Input injection for v0.3 control: the Quest sends taps/swipes
             to POST /control and this service performs them. Enabled once
             by the user in Settings → Accessibility. -->
        <service
            android:name=".QpmAccessibilityService"
            android:exported="false"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>
    </application>
</manifest>
