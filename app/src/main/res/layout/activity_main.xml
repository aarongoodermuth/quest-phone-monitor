<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B0F14"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/app_name"
        android:textColor="#FFFFFF"
        android:textSize="28sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Your phone, as a big screen in Quest 3"
        android:textColor="#9CA3AF"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/device_info"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:textColor="#D1D5DB"
        android:textSize="15sp" />

    <!-- Connection state: searching / connected to <device> / disconnected. -->
    <TextView
        android:id="@+id/connection_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Searching for your phone…"
        android:textColor="#60A5FA"
        android:textSize="15sp"
        android:textStyle="bold" />

    <!-- Phone-shaped view. The ImageView shows the live stream when
         connected; otherwise the container is the v0.1 placeholder and
         tapping it cycles the test colors. -->
    <FrameLayout
        android:id="@+id/phone_screen_container"
        android:layout_width="240dp"
        android:layout_height="480dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="12dp"
        android:background="#111827">

        <ImageView
            android:id="@+id/phone_screen_image"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitCenter"
            android:visibility="gone" />
    </FrameLayout>

    <TextView
        android:id="@+id/status_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="16dp"
        android:gravity="center"
        android:text="No phone connected yet.\nStart sharing on your phone — the Quest finds it automatically."
        android:textColor="#D1D5DB"
        android:textSize="15sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="16dp"
        android:gravity="center"
        android:text="Next: wired USB mode (no Wi-Fi needed) • then PC remote desktop"
        android:textColor="#6B7280"
        android:textSize="13sp" />

</LinearLayout>
