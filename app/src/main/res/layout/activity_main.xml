<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B0F14"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/app_name"
        android:textColor="#FFFFFF"
        android:textSize="28sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Your phone, as a big screen in Quest 3"
        android:textColor="#9CA3AF"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/device_info"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:textColor="#D1D5DB"
        android:textSize="15sp" />

    <!-- Phone-shaped placeholder. In v0.2 this becomes the live stream view. -->
    <View
        android:id="@+id/phone_screen_placeholder"
        android:layout_width="240dp"
        android:layout_height="480dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="20dp"
        android:background="#111827" />

    <TextView
        android:id="@+id/status_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="16dp"
        android:gravity="center"
        android:text="Phone screen will appear here.\nStreaming not built yet — the button below just proves the panel responds to input."
        android:textColor="#D1D5DB"
        android:textSize="15sp" />

    <Button
        android:id="@+id/test_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="16dp"
        android:text="Tap to test input" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="16dp"
        android:gravity="center"
        android:text="Next: Wi-Fi stream (same network) • then wired USB (no Wi-Fi needed)"
        android:textColor="#6B7280"
        android:textSize="13sp" />

</LinearLayout>
